{
  "datasets": [
    {
      "name": "h2s",
      "displayName": "H2S profile",
      "queryLines": [
        "SELECT well_id, basin, h2s_risk_level, CAST(h2s_ppm_last_measured AS DOUBLE) AS h2s_ppm, h2s_measurement_date, datediff(current_date(), h2s_measurement_date) AS days_since_sample, last_safety_audit_date, datediff(current_date(), last_safety_audit_date) AS days_since_audit, safety_status, ppe_level FROM oil_pump_monitor_catalog.subsurface_command.well_h2s_profile"
      ]
    },
    {
      "name": "equip",
      "displayName": "Sour-service components",
      "queryLines": [
        "SELECT well_id, component_name, required_spec, degradation_mechanism, risk_score, CAST(upgrade_capex_musd AS DOUBLE) AS upgrade_capex_musd, upgrade_lead_weeks FROM oil_pump_monitor_catalog.subsurface_command.well_equipment_integrity WHERE upgrade_required"
      ]
    },
    {
      "name": "inv",
      "displayName": "Sour-critical inventory",
      "queryLines": [
        "SELECT part_id, part_name, category, on_hand_qty, CAST(daily_burn AS DOUBLE) AS daily_burn, round(on_hand_qty / daily_burn, 1) AS days_of_cover, lead_time_days, supplier FROM oil_pump_monitor_catalog.subsurface_command.drilling_inventory WHERE category IN ('Wellhead', 'Casing')"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Sour-service readiness",
      "layout": [
        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "## Sour-service readiness\n",
                "H2S, equipment and inventory for sour wells, from the governed Unity Catalog tables the engineer's morning action items are built on. Filter to **EASTTEXAS-05** (12,000 ppm) for the extreme-band well."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "ppm",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "h2s",
                  "fields": [
                    {
                      "name": "well_id",
                      "expression": "`well_id`"
                    },
                    {
                      "name": "sum(h2s_ppm)",
                      "expression": "SUM(`h2s_ppm`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "well_id",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "well_id"
                },
                "y": {
                  "fieldName": "sum(h2s_ppm)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "h2s_ppm"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "H2S last measured (ppm)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 5
          }
        },
